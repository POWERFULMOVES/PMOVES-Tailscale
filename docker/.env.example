# Docker Tailscale environment variables

# Auth key (required — create via Headscale or Tailscale admin console)
TAILSCALE_AUTHKEY=

# Router mode
TAILSCALE_HOSTNAME=pmoves-vps
TAILSCALE_TAGS=tag:pmoves-vps
# Set to your VPS internal subnet (e.g. 172.31.x.0/24)
TAILSCALE_ADVERTISE_ROUTES=

# Headscale (omit for Tailscale SaaS)
HEADSCALE_URL=https://headscale.pmoves.ai

# Userspace mode (set true on VPS without TUN device)
TS_USERSPACE=false

# Sidecar mode (for per-service identity)
TS_SIDECAR_NAME=pmoves-ts-sidecar
TS_SIDECAR_HOSTNAME=pmoves-sidecar
