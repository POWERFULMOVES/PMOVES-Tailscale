# PMOVES Tailscale — VPS Profile
# For Hostinger/cloud VPS nodes. Prefers Docker sidecar mode.

TAILSCALE_TAGS=tag:pmoves,tag:pmoves-vps
TAILSCALE_SSH=true
TAILSCALE_ACCEPT_ROUTES=true
TAILSCALE_DOCKER_MODE=true
# Set to your VPS internal subnet (e.g. 172.31.x.0/24)
TAILSCALE_ADVERTISE_ROUTES=
TAILSCALE_SIGN_AUTHKEY=auto
