# PMOVES Tailscale — Proxmox Hypervisor Profile
# For Proxmox host-level install. VMs/LXCs get optional individual identity.

TAILSCALE_TAGS=tag:pmoves,tag:proxmox
TAILSCALE_SSH=true
TAILSCALE_ACCEPT_ROUTES=true
TAILSCALE_DOCKER_MODE=false
# Set to your Proxmox internal subnet (e.g. 10.10.10.0/24)
TAILSCALE_ADVERTISE_ROUTES=
TAILSCALE_SIGN_AUTHKEY=auto
